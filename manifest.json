{
  "manifest_version": 2,
  "name": "Local Google Fonts",
  "version": "1.1.0",
  "description": "Local font and SVG icon replacements for YouTube and YouTube Studio.",
  "browser_specific_settings": {
    "gecko": {
      "id": "local-google-fonts@example.org"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*",
    "https://www.youtube.com/*",
    "https://studio.youtube.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://studio.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "fonts/material-symbols.css",
    "fonts/MaterialSymbolsOutlined.ttf",
    "icons/*.svg"
  ]
}
